# HTTP health endpoint and WebSocket port
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL example. Use a secret password in production.
DATABASE_URL=postgresql://mmo_user:change_this_password@127.0.0.1:5432/rpgmaker_mmo

# Set to true when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false

# Relative to server/. The default assumes PROJECT/data and PROJECT/server.
# It is used by npm run inspect:mv and npm run validate:mv.
RPG_MV_DATA_PATH=../data

# Optional override for `npm run generator:manifest`. By default it uses the
# Generator folder adjacent to data/: PROJECT/img/generator.
# RPG_MV_GENERATOR_PATH=../img/generator

# Initial character spawn. These must be valid coordinates on the corresponding MV map.
START_MAP_ID=1
START_X=10
START_Y=10
